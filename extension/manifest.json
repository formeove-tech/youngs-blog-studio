{
  "manifest_version": 3,
  "name": "블로그 작업실 → 네이버 블로그",
  "description": "블로그 작업실에서 쓴 글과 사진을 네이버 블로그 글쓰기 화면에 넣어줍니다. 발행은 직접 누릅니다.",
  "version": "0.1.0",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://youngs-blog-studio.onrender.com/*", "http://127.0.0.1:3030/*", "https://blog.naver.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://youngs-blog-studio.onrender.com/*", "http://127.0.0.1:3030/*"], "js": ["studio.js"], "run_at": "document_idle" },
    { "matches": ["https://blog.naver.com/*"], "js": ["match.js", "naver.js"], "run_at": "document_idle", "all_frames": true }
  ]
}
